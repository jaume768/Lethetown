# Partidas de estudio largas (7 días de juego con el LLM real). Es una CAPA sobre tu .env, sin
# secretos: la API key y la contraseña de Postgres siguen en .env. Cópialo a .env.study (no se
# sube), cambia lo que haga falta y cárgalo en la shell antes de `pnpm dev`: dotenv no pisa lo
# que ya está definido, así que esto manda sobre .env.
#
#   set -a; . ./.env.study; set +a; pnpm dev
#
# Coste orientativo (partida 2, 72 h, sin Batch): 1,6 $ por día de juego; con Batch, la
# consolidación y la crónica (casi la mitad del gasto) cuestan la mitad.

LLM_PROVIDER=anthropic
# A x10: 1 día de juego = 2,4 h reales (7 días ≈ 17 h). La Batch API solo se usa si ningún mundo
# va más rápido que LLM_BATCH_MAX_SPEED: las noches (consolidación) tienen que ir a x10 o menos.
SIM_SPEED=10
LLM_BATCH=on
LLM_BATCH_TASKS=consolidate,chronicle
LLM_BATCH_MAX_SPEED=10
LLM_BATCH_MAX_WAIT_MINUTES=30
# Sin espectadores no se ralentiza ni se pausa: la partida sigue aunque nadie la mire.
NO_VIEWERS_MODE=off
# Modo demostración (tiempo de Mallorca por estaciones, averías, alguna voz interior): on u off,
# según lo que se quiera estudiar. Para comparar dos semillas, igual en las dos.
SIM_DEMO=off
# Respuesta al minuto y x10 en las charlas (ya son los valores por defecto).
SIM_REPLY_DELAY_MINUTES=1
SIM_SLOWDOWN_IN_CONVERSATION=on
LLM_CONCURRENCY=8
# Semilla del azar: una partida por semilla, cada una en su base de datos (ver abajo).
SIM_SEED=7
# DATABASE_URL=postgres://lethetown:<contraseña de .env>@localhost:5433/lethetown_estudio_s7

# --- Una partida de 7 días con dos semillas (7 y 13), una detrás de otra -------------------
# Cada semilla, en una base de datos nueva (el mundo empieza en el día 0):
#
#   pnpm db:up
#   docker exec lethetown-db createdb -U lethetown lethetown_estudio_s7
#   # en .env.study: SIM_SEED=7 y DATABASE_URL=…/lethetown_estudio_s7
#   set -a; . ./.env.study; set +a; pnpm db:migrate && pnpm dev
#
# En otra terminal, grabar 168 h de juego (un usuario director para pausar al acabar):
#
#   pnpm user:create grabador director
#   set -a; . ./.env.study; set +a
#   RECORD_USER=grabador RECORD_PASSWORD=… \
#     pnpm --filter @lethetown/server record ../../estudio/semana-s7 --hours 168
#   pnpm --filter @lethetown/server world:export ../../estudio/semana-s7/bd
#
# Luego lo mismo con SIM_SEED=13 y lethetown_estudio_s13 (estudio/semana-s13), y comparar:
#
#   pnpm study:analyze estudio/semana-s7 estudio/semana-s13
