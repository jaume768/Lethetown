# Partidas de estudio largas (7 días de juego con el LLM real). Es una CAPA sobre tu .env, sin
# secretos: la API key y la contraseña de Postgres siguen en .env. Cópialo a .env.study (no se
# sube), cambia lo que haga falta y cárgalo en la shell antes de `pnpm dev`: dotenv no pisa lo
# que ya está definido, así que esto manda sobre .env.
#
#   set -a; . ./.env.study; set +a; pnpm dev
#
# Coste orientativo (partida 2, 72 h, sin Batch): 1,6 $ por día de juego; con Batch, la
# consolidación y la crónica (casi la mitad del gasto) cuestan la mitad.

LLM_PROVIDER=anthropic
# A x10: 1 día de juego = 2,4 h reales (7 días ≈ 17 h). La Batch API solo se usa si ningún mundo
# va más rápido que LLM_BATCH_MAX_SPEED: las noches (consolidación) tienen que ir a x10 o menos.
SIM_SPEED=10
# Noche rápida: con todos dormidos y ya consolidados (y la crónica escrita), x360 hasta las 06:30.
# Mientras se consolida va a SIM_SPEED, así que los lotes se pueden usar. Un día ≈ 1,7–2 h reales.
SIM_NIGHT_SPEED=360
SIM_WAKE_MARGIN_MINUTES=30
LLM_BATCH=on
LLM_BATCH_TASKS=consolidate,chronicle
LLM_BATCH_MAX_SPEED=10
LLM_BATCH_MAX_WAIT_MINUTES=30
# Sin espectadores no se ralentiza ni se pausa: la partida sigue aunque nadie la mire.
NO_VIEWERS_MODE=off
# Modo demostración (tiempo de Mallorca por estaciones, averías, alguna voz interior): on u off,
# según lo que se quiera estudiar. Para comparar dos semillas, igual en las dos.
SIM_DEMO=off
# Respuesta al minuto y x10 en las charlas (ya son los valores por defecto).
SIM_REPLY_DELAY_MINUTES=1
SIM_SLOWDOWN_IN_CONVERSATION=on
LLM_CONCURRENCY=8
# Semilla del azar: una partida por semilla, cada una en su base de datos (ver abajo).
SIM_SEED=7
# DATABASE_URL=postgres://lethetown:<contraseña de .env>@localhost:5433/lethetown_estudio_s7

# --- Una partida de 7 días con dos semillas (7 y 13) en paralelo ----------------------------
# Un fichero por semilla (.env.study.s7, .env.study.s13; no se suben), cada uno con su base de
# datos nueva, su puerto y su origen permitido:
#
#   SIM_SEED=7   DATABASE_URL=…/lethetown_estudio_s7   PORT=3001 ALLOWED_ORIGINS=http://localhost:5173
#   SIM_SEED=13  DATABASE_URL=…/lethetown_estudio_s13  PORT=3002 ALLOWED_ORIGINS=http://localhost:5174
#
# Preparar las bases y los usuarios directores, arrancar los dos servidores (sin la web) y
# grabar 168 h de cada uno: scripts/estudio-semana.sh (prepare | start | record | status | stop).
#
# Las dos semillas comparten la caché de prompts (misma cuenta, mismo prompt fijo): el reparto
# del coste entre ellas es arbitrario y lo que vale es la suma (study:analyze la da). Para que
# no planifiquen en el mismo segundo, arráncalas desfasadas:
#
#   STUDY_DIR=estudio/semana-e4 OFFSET_MINUTES=30 scripts/estudio-semana.sh start
#
# Un tercer mundo de control, opcional (ABLATION=on en el script): la semilla 7 sin olvido ni
# vaguedad (flags de MemoryConfig.ablation), en .env.study.s7a:
#
#   SIM_SEED=7  DATABASE_URL=…/lethetown_estudio_s7a  PORT=3003 ALLOWED_ORIGINS=http://localhost:5175
#   MEMORY_ABLATION=noForgetting,noVagueness
# Al acabar, por semilla (con su DATABASE_URL):
#
#   pnpm --filter @lethetown/server world:export ../../estudio/semana-fase3/s7/bd --world default
#   pnpm study:analyze estudio/semana-fase3/s7 estudio/semana-fase3/s13
