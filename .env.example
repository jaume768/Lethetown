# Copia este archivo a .env (`pnpm dev` lo hace solo la primera vez, con una contraseña aleatoria).
# Nunca subas .env al repositorio.

# --- Proveedor LLM ---------------------------------------------------------
# mock | anthropic | openai  (mock no necesita red ni API keys)
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelos por tipo de tarea ("fast" = decisiones cotidianas, "reflection" = reflexión/plan)
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_REFLECTION=claude-sonnet-5-5
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_REFLECTION=gpt-6-sol

# Máximo de llamadas al LLM en paralelo (respeta rate limits)
LLM_CONCURRENCY=4
# Timeout por intento, reintentos con backoff+jitter (429/5xx/red) y circuit breaker
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES=3
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_SECONDS=30
# Batch API de Anthropic (50 % más barata, asíncrona) para tareas sin prisa. Solo se usa si
# ningún mundo va más rápido que LLM_BATCH_MAX_SPEED; si el lote tarda más que
# LLM_BATCH_MAX_WAIT_MINUTES, se repite por la vía normal.
LLM_BATCH=off
LLM_BATCH_TASKS=consolidate,chronicle
LLM_BATCH_MAX_SPEED=10
LLM_BATCH_MAX_WAIT_MINUTES=30
LLM_BATCH_POLL_SECONDS=30

# --- Base de datos ---------------------------------------------------------
# Postgres de docker-compose (solo escucha en 127.0.0.1). Las credenciales deben coincidir
# con DATABASE_URL.
POSTGRES_USER=lethetown
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=lethetown
POSTGRES_PORT=5433
# Si se deja vacía (o Postgres no responde) se usa un almacén en memoria.
DATABASE_URL=postgres://lethetown:cambia-esta-contraseña@localhost:5433/lethetown

# --- Embeddings ------------------------------------------------------------
# local = transformers.js (descarga ~25MB la primera vez) | hash = determinista, sin red.
# Si no hay red o el modelo no carga, el servidor cae solo a hash.
EMBEDDINGS=local
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2

# --- Simulación ------------------------------------------------------------
# Minutos de juego que avanza cada tick de simulación
SIM_TICK_MINUTES=10
# Velocidad inicial: 0 (pausa), 1, 10, 60, 360
SIM_SPEED=10
# Velocidad de paseo (baldosas de 16 px por minuto de juego)
SIM_WALK_TILES_PER_MINUTE=6
# Semilla del azar de la memoria (vacía = aleatoria; fija = simulación reproducible en mock)
SIM_SEED=

# --- Servidor --------------------------------------------------------------
NODE_ENV=development
PORT=3001
# 127.0.0.1 en desarrollo; 0.0.0.0 dentro de Docker
HOST=127.0.0.1
# Orígenes permitidos (CORS, WebSocket y peticiones que mutan), separados por comas
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true detrás de un proxy (Caddy) para leer la IP real de X-Forwarded-For
TRUST_PROXY=false
# Cookie de sesión con Secure (vacío = solo en producción)
COOKIE_SECURE=
SESSION_TTL_HOURS=168
# Solo en RAM y fuera de producción: crea el usuario "admin" con esta contraseña (mín. 10)
DEV_ADMIN_PASSWORD=

# Límites (por IP y minuto)
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_INTERVENTION_PER_MINUTE=10
RATE_LIMIT_CHRONICLE_PER_MINUTE=2
BODY_LIMIT_BYTES=16384
WS_MAX_PAYLOAD_BYTES=4096
WS_MAX_PER_IP=8
WS_HEARTBEAT_SECONDS=30

# --- Presupuesto de LLM (USD, día y mes UTC; 0 = sin límite) ----------------
# Al superarlo el mundo se pausa solo. El admin tiene además un kill switch.
BUDGET_DAILY_USD=5
BUDGET_MONTHLY_USD=50
WORLD_BUDGET_DAILY_USD=2
WORLD_BUDGET_MONTHLY_USD=20

# --- Texto de los jugadores (voz interior, estados de objetos) -------------
USER_TEXT_MAX=280
# llm = moderar con el modelo fast antes de aceptar | off = solo límites y delimitación
MODERATION=llm
